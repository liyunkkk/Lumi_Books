<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_coverflow_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <!-- Dynamic Liquid Glass Card Background with Specular Reflection & Opacity Control -->
    <ImageView
        android:id="@+id/widget_card_bg_dynamic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_coverflow_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left 3D Carousel Display -->
        <FrameLayout
            android:id="@+id/widget_left_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <ImageView
                android:id="@+id/widget_coverflow_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_cover_content_description"
                android:scaleType="fitCenter" />

            <!-- Invisible Touch zones for prev / read / next (Strictly invisible, no arrow icons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_touch_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_cover_content_description" />

                <ImageView
                    android:id="@+id/widget_touch_read"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:contentDescription="@string/widget_cover_content_description" />

                <ImageView
                    android:id="@+id/widget_touch_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_cover_content_description" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right Meta & Controls: Rigid Anchored Skeleton (Zero-Jitter on Book Switching) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1.4"
            android:orientation="vertical">

            <!-- Top Header (Fixed Height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_header_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="📖 正在阅读 ›"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/widget_btn_history"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/widget_quote_name"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_clock" />

                <ImageView
                    android:id="@+id/widget_btn_more"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginLeft="3dp"
                    android:contentDescription="@string/widget_continue_name"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_more" />
            </LinearLayout>

            <!-- Book Title: Single Line Fixed Anchor -->
            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_book_title"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Author: Single Line Fixed Anchor -->
            <TextView
                android:id="@+id/widget_book_author"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_author"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <!-- Book Quote: Rigorously Fixed 28dp Height (Never shifts subsequent views!) -->
            <TextView
                android:id="@+id/widget_book_quote"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="“生活不能等待别人来安排，要自己去争取和奋斗。”"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <!-- Progress Text Row: Fixed Height -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="已读 0%"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_chapter_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="第 1 章"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Thin Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_bar_horizontal" />

            <!-- Space placeholder to absorb any height expansion (FrameLayout is RemoteViews-compliant) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Action Buttons Row: Strictly Bottom Anchored, Equal Proportions, Never Truncated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary: Continue Reading -->
                <FrameLayout
                    android:id="@+id/widget_btn_continue_wrap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15">

                    <ImageView
                        android:id="@+id/widget_btn_continue_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_pill_white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_widget_read_white" />

                        <TextView
                            android:id="@+id/widget_btn_continue_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginLeft="2dp"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/continue_reading"
                            android:textColor="#FFFFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Secondary 1: Bookshelf -->
                <LinearLayout
                    android:id="@+id/widget_btn_bookshelf"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="0.95"
                    android:background="@drawable/widget_glass_pill_background"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_widget_bookmark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginLeft="2dp"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_bookshelf"
                        android:textColor="@color/widget_pill_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Secondary 2: Details -->
                <LinearLayout
                    android:id="@+id/widget_btn_details"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="0.95"
                    android:background="@drawable/widget_glass_pill_background"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_widget_arrow_right" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginLeft="2dp"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_view_details"
                        android:textColor="@color/widget_pill_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_coverflow_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:padding="16dp"
        android:text="@string/widget_no_recent_book"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>